
@{
    // ViewData["Title"] = "ConfiguracionCuenta";
    ViewData["TitleHeader"] = "Configuración de la cuenta";
    Layout = "/Views/Shared/_Layout.cshtml";
}

@if (TempData["MensajeVendedor"] != null)
{
    <div class="alert alert-warning">
        @TempData["MensajeVendedor"]
    </div>
}


<style>

body {
    font-family: 'Poppins', sans-serif;
    background: #f5f5f5;
}

/* Contenedor general */
.container {
    max-width: 900px;
    margin: 40px auto;
    background: #fff;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0px 4px 20px rgba(0,0,0,0.05);
}

/* Títulos */
h4 {
    font-size: 20px;
    font-weight: 600;
    color: #FF8800;
    margin-top: 35px;
    padding-bottom: 8px;
    border-bottom: 2px solid #ffe1c2;
}

/* ====== FORMULARIOS ====== */
.form-group {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 15px;
}

.form-group input,
.form-group select {
    flex: 1;
    font-size: 15px;
    background: transparent;
    padding: 10px 5px;
    border: none;
    border-bottom: 2px solid #ccc;
    transition: all 0.3s ease;
}

.form-group input:focus,
.form-group select:focus {
    border-bottom: 2px solid #FF8800;
    outline: none;
}

/* ===== CHECKBOX ===== */
.checkbox-group {
    display: flex;
    align-items: center;
    margin-top: 15px;
}
.checkbox-group label {
    margin-left: 8px;
}

/* ===== ACCIONES ===== */
.form-actions {
    margin-top: 20px;
    display: flex;
    gap: 15px;
}

/* ===== BOTONES ===== */
.btnNaranja,
.btnOrange,
.btn-primary,
.btn-secondary {
    padding: 10px 20px !important;
    border-radius: 8px !important;
    font-weight: 500;
    transition: 0.2s;
}

.btnNaranja {
    background-color: #fff !important;
    border: 2px solid #FF8800 !important;
    color: #FF8800 !important;
}
.btnNaranja:hover {
    background-color: #FF8800 !important;
    color: #fff !important;
}

.btnOrange {
    background-color: #FF8800 !important;
    border: 2px solid #FF8800 !important;
    color: #fff !important;
}
.btnOrange:hover {
    background-color: #e06f00 !important;
}

.btn-primary {
    background-color: #FF8800 !important;
    border-color: #FF8800 !important;
}
.btn-primary:hover {
    background-color: #e06f00 !important;
}

.btn-secondary {
    background-color: #dcdcdc !important;
    color: #333 !important;
}

/* ====== MODALES ====== */
.modal-content {
    border-radius: 12px !important;
    border: none !important;
}

.modal-header {
    background: #fff7f0;
    border-bottom: 1px solid #ffd4ad;
}

.modal-title {
    font-weight: 600;
    color: #FF8800;
}

/* Inputs modal */
.modal-content input,
.modal-content select {
    border-radius: 6px !important;
    border: 1px solid #ccc !important;
    padding: 10px !important;
}

/* ====== RESPONSIVE ====== */
@@media (max-width: 600px) {
    .form-group {
        flex-direction: column;
    }
    .form-actions {
        flex-direction: column;
        width: 100%;
    }
    .form-actions button {
        width: 100%;
    }
}


</style>

    <!-- Información Personal -->
    <h4 class ="mt-2">Información personal</h4>
    <div class="form-group">
        <input type="text" placeholder="Nombres" id="Nombres">
        <input type="text" placeholder="Apellido Paterno" id="Apaterno">
        <input type="text" placeholder="Apellido Materno" id="Amaterno">
    </div>
    <div class="form-group">
        <input type="tel" placeholder="Teléfono" id="Telefono">
        <input type="email" placeholder="Correo electrónico" id="Correo" readonly>
    </div>
    <div class="form-actions">
        <button class="btn btnNaranja w-20 mb-3" id="guardaInfoUsuario">Guardar información</button>
    <button class="btn btnNaranja w-20 mb-3" id="quieroVenderBtn">Quiero vender</button>
    </div>

    <!-- Direcciones de Envío -->
    <h4 class="mt-2">Direccion predeterminada</h4>
    <div class="form-group">
        <input type="text" id="calleNum" placeholder="Calle y Número" readonly>
        <input type="text" id="Colonia" placeholder="Colonia" readonly>
    </div>
    <div class="form-group">
        <input type="text" id="Estado" placeholder="Estado" readonly>
        <input type="text" id="CodigoPostal" placeholder="Código Postal" readonly>
    </div>
    <div class="form-actions">
        <button class="btn btnNaranja w-20 mb-3" id="AgregarDireccion">Agregar dirección</button>
        <button class="btn btnNaranja w-20 mb-3" id="misDirecciones">Mis Direcciones</button>
    </div>

    <!-- Métodos de Pago -->
    <h4 class="mt-2">Método de pago predeterminado</h4>
    <div class="form-group">
    <input type="text" id="inputMetodoPredeterminado" placeholder="Sin métodos de pago" readonly class="form-control">
    </div>
    <div class="form-actions">
    <button class="btn btn-primary w-20 mb-3" data-bs-toggle="modal" data-bs-target="#modalAgregarMetodo">Agregar método de pago</button>
    <button class="btn btn-secondary w-20 mb-3" id="btnMisMetodos">Mis métodos de pago</button>
    </div>


    <!-- Preferencias de notificaciones -->
    <h4 class="mt-2">Preferencias de notificaciones</h4>
    <div class="checkbox-group">
        <input type="checkbox" id="boletines">
        <label for="boletines">Recibir boletines y actualizaciones por correo.</label>
    </div>
    <div class="form-actions">
        <button class="btn btnNaranja w-20 mb-3">Guardar preferencias</button>
    </div>

    <!-- Configuraciones de seguridad -->
    <h4 class="mt-2">Configuraciones de seguridad</h4>
<div class="form-group">
    <input type="password" id="passwordActual" placeholder="Contraseña actual" class="form-control mb-2">
    <input type="password" id="passwordNueva" placeholder="Nueva contraseña" class="form-control">
</div>
<div class="form-actions">
    <button class="btn btnNaranja w-20 mb-3" id="btnCambiarPassword">Guardar contraseña</button>
</div>


<!-- Modal Agregar método de pago-->
<div class="modal fade" id="modalAgregarMetodo" tabindex="-1" aria-labelledby="modalAgregarMetodoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAgregarMetodoLabel">Agregar método de pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formAgregarMetodo">
                    <div class="mb-3">
                        <label for="metodoPago" class="form-label">Método de pago</label>
                        <select class="form-select" id="metodoPago" name="MetodoPagoId" required>
                            <option value="">-- Selecciona --</option>
                            <option value="16">Tarjeta de crédito</option>
                            <option value="17">Tarjeta de débito</option>
                            <option value="18">PayPal</option>
                            <option value="19">Mercado Pago</option>
                            <option value="20">Pago en efectivo (OXXO)</option>
                            <option value="21">Transferencia bancaria</option>
                            <option value="22">SPEI</option>
                        </select>
                    </div>

                    <!-- Sección Tarjetas -->
                    <div class="campos-metodo d-none" data-metodo="16,17">
                        <div class="mb-3">
                            <label for="numeroTarjeta" class="form-label">Número de tarjeta</label>
                            <input type="text" class="form-control" id="numeroTarjeta" name="NumeroTarjeta" placeholder="**** **** **** 1234">
                        </div>
                        <div class="mb-3">
                            <label for="fechaVencimiento" class="form-label">Fecha de vencimiento</label>
                            <input type="month" class="form-control" id="fechaVencimiento" name="FechaVencimiento">
                        </div>
                        <div class="mb-3">
                            <label for="nombreTitular" class="form-label">Nombre del titular</label>
                            <input type="text" class="form-control" id="nombreTitular" name="NombreTitular">
                        </div>
                    </div>

                    <!-- Sección PayPal -->
                    <div class="campos-metodo d-none" data-metodo="18">
                        <div class="mb-3">
                            <label for="cuentaPaypal" class="form-label">Cuenta PayPal</label>
                            <input type="email" class="form-control" id="cuentaPaypal" name="CuentaPaypal" placeholder="ejemplo@correo.com">
                        </div>
                    </div>

                    <!-- Sección MercadoPago -->
                    <div class="campos-metodo d-none" data-metodo="19">
                        <div class="mb-3">
                            <label for="cuentaMP" class="form-label">Cuenta Mercado Pago</label>
                            <input type="email" class="form-control" id="cuentaMP" name="CuentaMercadoPago" placeholder="ejemplo@correo.com">
                        </div>
                    </div>

                    <!-- Sección efectivo (OXXO) -->
                    <div class="campos-metodo d-none" data-metodo="20">
                        <p>Se generará una referencia para pagar en OXXO.</p>
                    </div>

                    <!-- Sección transferencia/SPEI -->
                    <div class="campos-metodo d-none" data-metodo="21,22">
                        <p>Se mostrarán los datos bancarios al confirmar la compra.</p>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formAgregarMetodo" class="btn btn-primary">Guardar</button>
            </div>
        </div>
    </div>
</div>
<!-- End Modal-->

<!-- Modal para listar métodos de pago -->
<div class="modal fade" id="modalMisMetodos" tabindex="-1" aria-labelledby="modalMisMetodosLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalMisMetodosLabel">Mis métodos de pago</h5>
                <button type="button" class="btn btn-link p-0" data-bs-dismiss="modal" aria-label="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <ul id="listaMetodosPago" class="list-group">
                    <!-- Aquí se llenarán los métodos via AJAX -->
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<!-- End Modal-->

<!-- Modal Agregar dirección-->
<div class="modal fade modal-direccion" id="mdlAddDireccion" tabindex="-1" role="dialog" aria-labelledby="mdlAddDireccionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="mdlAddDireccionLabel">Agregar Dirección</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="formAddDireccion">
                    <!-- Fila 1: Calle, No. Interior, No. Exterior -->
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" id="calle" placeholder="Calle">
                            <div class="invalid-feedback">Este campo es obligatorio.</div>
                        </div>
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" id="numInterior" placeholder="No. Interior">
                        </div>
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" id="numExterior" placeholder="No. Exterior">
                            <div class="invalid-feedback">Este campo es obligatorio.</div>
                        </div>
                    </div>

                    <!-- Fila 2: Localidad, Municipio, Código Postal -->
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <input type="text" class="form-control" id="localidad" placeholder="Localidad">
                            <div class="invalid-feedback">Este campo es obligatorio.</div>
                        </div>
                        <div class="form-group col-md-4">
                            <input type="text" class="form-control" id="municipio" placeholder="Municipio">
                            <div class="invalid-feedback">Este campo es obligatorio.</div>
                        </div>
                        <div class="form-group col-md-4">
                            <input type="text" class="form-control" id="codigoPostal" placeholder="Código Postal" maxlength="5" pattern="\d{5}">
                            <div class="invalid-feedback">Este campo es obligatorio.</div>
                        </div>
                    </div>

                    <!-- Fila 3: Estado, País -->
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <select class="form-control" id="estado">
                                <option value="">Selecciona un estado</option>
                                <option value="CDMX">Ciudad de México</option>
                                <option value="JAL">Jalisco</option>
                                <option value="NL">Nuevo León</option>
                            </select>
                            <div class="invalid-feedback">Este campo es obligatorio.</div>
                        </div>
                        <div class="form-group col-md-6">
                            <select class="form-control" id="pais">
                                <option value="">Selecciona un país</option>
                                <option value="MX">México</option>
                                <option value="US">Estados Unidos</option>
                                <option value="CA">Canadá</option>
                            </select>
                            <div class="invalid-feedback">Este campo es obligatorio.</div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarDireccion">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- End Modal-->

<!-- Modal dirección predeterminada -->
<div class="modal fade" id="modalDirecciones" tabindex="-1" role="dialog" aria-labelledby="modalDireccionesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalDireccionesLabel">Mis direcciones</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body" id="contenedorDirecciones">
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="guardarDireccionPredeterminada">Guardar</button>
            </div>

        </div>
    </div>
</div>

<!-- End Modal-->

<div class="d-flex justify-content-end">
    <button type="button" class="btn btnOrange w-20 mb-2 me-2" id="regresar">
        Regresar
    </button>
</div>

<!-- Modal registro vendedor -->
<div class="modal fade" id="mdlRegistroVendedor" tabindex="-1" aria-labelledby="documentosModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- Encabezado -->
            <div class="modal-header">
                <h5 class="modal-title" id="documentosModalLabel">Datos del Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <!-- Cuerpo -->
            <div class="modal-body">
                <form id="documentosForm">

                    <!-- RFC -->
                    <div class="mb-3">
                        <label for="rfc" class="form-label">RFC</label>
                        <input type="text" class="form-control" id="rfc" name="rfc" maxlength="13" placeholder="Ingrese RFC">
                    </div>

                    <!-- CURP -->
                    <div class="mb-3">
                        <label for="curp" class="form-label">CURP</label>
                        <input type="text" class="form-control" id="curp" name="curp" placeholder="Ingrese CURP">
                    </div>

                    <!-- Cuenta Bancaria -->
                    <div class="mb-3">
                        <label for="cuentaBancaria" class="form-label">Cuenta Bancaria</label>
                        <input type="text" class="form-control" id="cuentaBancaria" name="cuentaBancaria" placeholder="Ingrese Cuenta Bancaria">
                    </div>

                    <!-- Recuadros de previsualización -->
                    <div class="row">
                        <div class="col-md-6 text-center">
                            <label class="form-label fw-bold">Identificación</label>
                            <div class="border rounded p-2 mb-2" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                                <img id="previewIdentificacion" src="" alt="Previsualización" style="max-height: 100%; max-width: 100%; display: none;">
                            </div>
                            <input type="file" class="form-control" id="identificacion" accept="image/*">
                        </div>

                        <div class="col-md-6 text-center">
                            <label class="form-label fw-bold">Comprobante de domicilio</label>
                            <div class="border rounded p-2 mb-2" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                                <img id="previewComprobante" src="" alt="Previsualización" style="max-height: 100%; max-width: 100%; display: none;">
                            </div>
                            <input type="file" class="form-control" id="comprobanteDomicilio" accept="image/*">
                        </div>
                    </div>

                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="documentosForm" id="btnRegistrarVendedor" class="btn btn-primary">Aceptar</button>
            </div>

        </div>
    </div>
</div>
<!-- End Modal-->

<script src="~/js/ConfiguracionCuenta.js"></script>