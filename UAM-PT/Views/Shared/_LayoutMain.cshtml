<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NovaMer</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/bootstrap/css/bootstrap.min.css" />
    <link href="~/css/site-theme.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-7D4J+o9lJ8UyJZ9k09vO4r0uUOKVrHD45Lkk9r2JZGSj7JgCh9mDqk0cOtgcxN1xuHnVhZ0E9N7crtHJ9OP9mA==" crossorigin="anonymous" referrerpolicy="no-referrer" />


    @await RenderSectionAsync("Scripts", required: false)
</head>
<body>
    <header class="header">
        <div class="header-inner container">
            <div class="logo">
                <img src="~/images/logo.png" alt="NovaMer" class="nav_image" />
            </div>

            <div class="search">
                <input id="buscador" type="text" placeholder="Buscar productos, marcas, categorías..." aria-label="Buscar" />
                <span class="icon"><i class="fas fa-search"></i></span>
            </div>

            <div class="actions">
                <div class="icon-btn carrito" title="Carrito">
                    <i class="fa-solid fa-cart-shopping" id="carritoIcon"></i>
                </div>

                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userDropdownMain" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="~/images/HollowKnight.webp" alt="Perfil" class="user-avatar" />
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdownMain">
                        <li><a class="dropdown-item" href="/Cuenta/ConfiguracionCuenta">Configuración de cuenta</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" id="MisPedidos" href="#">Mis pedidos</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" id="CerrarSesion" href="#">Cerrar sesión</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="header-subnav">
            <div class="container">
                <nav class="nav">
                    <a href="/Home/Inicio" class="active">Inicio</a>
                    <a href="#">Nuevo</a>
                    <a href="#">Lo más vendido</a>
                    <a href="#">Descuentos</a>
                    <a href="#">Categorías</a>
                    <a href="/Vender/PerfilVendedor">Vender</a>
                    <a href="#">Servicio al cliente</a>
                </nav>
            </div>
        </div>
    </header>

    <div class="content-body">
        <div class="content container">
            @RenderBody()
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; 2025 - NovaMer
        </div>
    </footer>

    <script src="~/js/site-theme.js"></script>
    <script>
        document.getElementById("carritoIcon").addEventListener("click", function () {
            window.location.href = '@Url.Action("CarritoDeCompras", "Carrito")';
        });
    </script>

</body>
</html>
