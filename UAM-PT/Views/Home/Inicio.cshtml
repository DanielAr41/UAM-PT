@{
    ViewData["Title"] = "NovaMer.com.mx";
    Layout = "/Views/Shared/_LayoutMain.cshtml";
}

<section class="catalogo-container">
    <h1 class="titulo-catalogo">Catálogo de Productos</h1>

    <div class="productos-grid" id="productosContainer">
        <!-- Productos dinámicos -->
    </div>
    <div class="ver-mas-container">
        <button class="btn-vermas" id="btnVerMas">Ver más</button>
    </div>
</section>

<script src="~/js/inicio.js?v=@Html.Raw(DateTime.Now.ToString("yyyyMMddHHmm"))"></script>

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #ffffff;
        margin: 0;
        padding: 0;
    }

    .catalogo-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .titulo-catalogo {
        text-align: center;
        font-weight: 600;
        margin-bottom: 40px;
        font-size: 32px;
        color: #222;
    }

    .productos-grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }

    .producto-card {
        background-color: #fff;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.05);
        padding: 18px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        transition: transform .18s, box-shadow .18s;
    }

    .producto-card:hover {
        transform: scale(1.03);
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
    }

    .producto-card img {
        width: 100%;
        height: 190px;
        border-radius: 10px;
        object-fit: cover;
        margin-bottom: 12px;
    }

    .producto-card h3 {
        font-size: 18px;
        margin: 0 0 6px;
        font-weight: 500;
        color: #111;
        text-align: left;
    }

    .producto-card .precio {
        font-size: 20px;
        font-weight: 700;
        color: #FF8800;
        margin-top: auto;
        text-align: left;
    }

    /* responsive ajustes ligeros */
    @@media(max-width: 480px) {
        .producto-card img {
            height: 160px;
        }
    }

    .ver-mas-container {
        display: flex;
        justify-content: center; 
        margin-top: 30px;
    }

    .btn-vermas {
        background-color: #FF8800;
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 0.6rem 1.4rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-vermas:hover {
        background-color: #e37300;
    }

</style>
