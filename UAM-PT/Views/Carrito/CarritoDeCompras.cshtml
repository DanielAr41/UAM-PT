
@{
    ViewData["Title"] = "CarritoDeCompras";
    Layout = "/Views/Shared/_Layout.cshtml";
}

@model UAM_PT.Models.CarritoModel

<main class="contenedor">
    <h2 class="titulo">Tu carrito de compras</h2>

    <div class="contenido">
        <!-- Lista de productos -->
        <div class="productos-container">
            <div class="productos">
                @foreach (var item in Model.Productos)
                {
                    <div class="producto">
                        <img src="@Url.Action("ObtenerImagen", "Home", new { id = item.ProductoId })" alt="@item.Nombre" />
                        <div class="info">
                            <h3>@item.Nombre</h3>
                            <p>Precio: @item.PrecioUnitario.ToString("C")</p>
                        </div>
                        <div class="precio">
                            <span class="cantidad">@item.Cantidad</span>
                            <span class="monto">@((item.Cantidad * item.PrecioUnitario).ToString("C"))</span>
                        </div>
                        <button class="btn-quitar" data-id="@item.ProductoId" title="Quitar del carrito">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                }
            </div>

            <a href="/Home/Inicio" class="continuar">Continuar comprando</a>
        </div>
        <!-- Resumen de la orden -->
        <div class="resumen">
            <h3>Resumen de la orden</h3>
            <div class="fila">
                <span>Subtotal</span>
                <span>@Model.Total.ToString("C")</span>
            </div>
            <div class="fila total">
                <span>Total</span>
                <span>@Model.Total.ToString("C")</span>
            </div>
            <button class="btn-pago">Proceder al pago</button>
        </div>
    </div>
</main>

<script src="~/js/CarritoDeCompras.js"></script>
                <style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: Arial, sans-serif;
        background-color: #fff;
        color: #333;
    }

    .header {
        display: flex;
        align-items: center;
        padding: 1rem 2rem;
        border-bottom: 1px solid #eee;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

        .header .icono {
            width: 24px;
            margin-right: 10px;
        }

        .header h1 {
            font-size: 1.5rem;
            font-weight: bold;
        }

    .contenedor {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .titulo {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .contenido {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
    }

    .productos {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .producto {
        display: flex;
        align-items: center;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        padding: 1rem;
    }

        .producto img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
        }

        .producto .info {
            margin-left: 1rem;
            flex: 1;
        }

            .producto .info h3 {
                font-weight: bold;
                margin-bottom: 0.2rem;
            }

            .producto .info p {
                font-size: 0.9rem;
                color: #666;
            }

    .precio {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .precio .cantidad {
            background-color: #f1f5f9;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.9rem;
        }

        .precio .monto {
            font-weight: bold;
        }

    .continuar {
        font-size: 0.9rem;
        color: #555;
        text-decoration: underline;
        margin-top: 1rem;
    }

    .resumen {
        width: 100%;
        max-width: 340px;
        padding: 1.5rem;
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .resumen h3 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

    .fila {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0.8rem 0;
        font-size: 0.95rem;
    }

    .codigo {
        padding: 6px 10px;
        border: none;
        background: #f1f5f9;
        border-radius: 8px;
        font-size: 0.9rem;
        width: 50%;
    }

    .btn-aplicar {
        background-color: #5C3D10;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        cursor: pointer;
        margin-top: 0.5rem;
    }

        .btn-aplicar:hover {
            background-color: #3e280b;
        }

    .total {
        font-weight: bold;
        font-size: 1rem;
    }

    .btn-pago {
        background-color: orange;
        color: white;
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        margin-top: 1rem;
    }

        .btn-pago:hover {
            background-color: darkorange;
        }

    .footer {
        text-align: center;
        padding: 2rem 0;
        font-size: 0.85rem;
        color: #777;
        border-top: 1px solid #eee;
        margin-top: 3rem;
    }

        .footer a {
            margin: 0 10px;
            text-decoration: none;
            color: inherit;
        }

            .footer a:hover {
                text-decoration: underline;
            }


    .productos {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-height: 500px; /* altura del scroll */
        overflow-y: auto;
        padding-right: 10px;
    }

        /* Opcional: estilo para la barra de scroll */
        .productos::-webkit-scrollbar {
            width: 8px;
        }

        .productos::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.2);
            border-radius: 4px;
        }

        .productos::-webkit-scrollbar-track {
            background-color: rgba(0,0,0,0.05);
            border-radius: 4px;
        }

    .continuar {
        display: block;
        margin-top: 10px;
        text-align: center;
        font-size: 0.9rem;
        color: #555;
        text-decoration: underline;
    }

    .btn-quitar {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-quitar i {
            color: black; /* rojo para que contraste */
            font-size: 1rem; /* tamaño grande */
            transition: color 0.2s;
        }

        .btn-quitar:hover i {
            color: #cc0000; /* rojo más oscuro al pasar el mouse */
        }



                </style>


<script src="~/js/CarritoDeCompras.js"></script>