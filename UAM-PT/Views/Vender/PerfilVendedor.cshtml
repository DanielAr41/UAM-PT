<section class="profile">
    <img src="~/images/HollowKnight.webp" alt="Usuario" class="profile-img" />
    <h2>Tus productos</h2>
    <p>Ciudad de México, México</p>
    <div class="stats">
        <span><strong>245</strong> Órdenes</span>
        <span><strong>78</strong> Clientes</span>
        <span><strong>28</strong> Productos</span>
    </div>
