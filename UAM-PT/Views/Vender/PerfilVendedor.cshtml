<div id="contenedor-inactivos" class="contenedor-productos products"></div>


<div class="ver-mas-container">
    <button class="btn-vermas">Ver más</button>
</div>

<!-- Modal -->
<div class="modal fade" id="mdlAddProducto" tabindex="-1" aria-labelledby="mdlAddProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title tituloNaranja" id="mdlAddProductoLabel">Nuevo Producto</h5>
                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-circle-fill" style="color:#FF8800"></i>
                </button>

            </div>

            <div class="modal-body">
                <form id="formAddProducto" enctype="multipart/form-data">

                    <!-- Imagen -->
                    <div class="file-upload-wrapper mb-3">
                        <label for="productoImagen" class="form-label text-center d-block">Imagen del producto</label>

                        <div class="file-upload-box">
                            <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>

                            <span id="file-name">Selecciona una imagen...</span>

                            <button type="button" class="btn-upload-trigger">Subir</button>

                            <!-- Tu input original (oculto) -->
                            <input type="file" class="form-control" id="productoImagen" name="Imagen" accept="image/*">

                            <!-- Preview de imagen -->
                            <div class="text-center mt-2">
                                <img id="previewProductoImg" src="#" alt="Vista previa" class="img-thumbnail d-none" style="max-height: 180px;">
                            </div>

                        </div>
                    </div>


                    <!-- Nombre y SKU -->
                    <div class="row mb-3">
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-tag"></i>
                                <input type="text" class="form-control" id="productoNombre" name="Nombre" required placeholder="Nombre del producto">
                            </div>

                        </div>
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-upc-scan"></i>
                                <input type="text" class="form-control" id="productoSKU" name="SKU" placeholder="SKU">
                            </div>
                        </div>
                    </div>

                    <!-- Precio y Categoría -->
                    <div class="row mb-3">
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-cash-stack"></i>
                                <input type="number" step="0.01" class="form-control" id="productoPrecio" name="Precio" required placeholder="Precio">
                            </div>

                        </div>
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-list-ul"></i>
                                <select class="form-select" id="productoCategoria" name="CategoriaID" required></select>
                            </div>
                        </div>
                    </div>

                    <!-- Peso y Stock -->
                    <div class="row mb-3">
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-weight"></i>
                                <input type="number" step="0.01" class="form-control" id="productoPeso" name="Peso" placeholder="Peso">
                            </div>
                        </div>
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-box-seam"></i>
                                <input type="number" class="form-control" id="productoStock" name="Stock" placeholder="Stock">
                            </div>
                        </div>
                    </div>

                    <!-- Descuento y Precio con descuento -->
                    <div class="row mb-3">
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-percent"></i>
                                <input type="number" step="0.01" class="form-control" id="productoDescuento" name="descuento" placeholder="Descuento (%)">
                            </div>
                        </div>
                        <div class="col">
                            <div class="input-icon">
                                <i class="bi bi-cash"></i>
                                <input type="number" step="0.01" class="form-control" id="productoPrecioDescuento" name="precio_descuento" placeholder="Precio con descuento">
                            </div>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-3">
                        <div class="input-icon textarea-icon">
                            <i class="bi bi-text-paragraph"></i>
                            <textarea class="form-control" id="productoDescripcion" name="Descripcion" rows="3" placeholder="Descripción del producto"></textarea>
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="submit" form="formAddProducto" class="btn btnNaranja">Guardar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>

        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="modalEditarProducto" tabindex="-1" aria-labelledby="editarProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="formEditarProducto" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="editarProductoLabel">Editar Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="ID" id="productoId" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="nombreProducto" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="nombreProducto" name="Nombre" required />
                        </div>

                        <div class="col-md-6">
                            <label for="precioProducto" class="form-label">Precio</label>
                            <input type="number" step="0.01" class="form-control" id="precioProducto" name="Precio" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="descripcionProducto" class="form-label">Descripción</label>
                        <textarea class="form-control" id="descripcionProducto" name="Descripcion" rows="3"></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="stockProducto" class="form-label">Stock</label>
                            <input type="number" class="form-control" id="stockProducto" name="Stock" required />
                        </div>

                        <div class="col-md-6">
                            <label for="pesoProducto" class="form-label">Peso</label>
                            <input type="number" step="0.01" class="form-control" id="pesoProducto" name="Peso" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="imagenProducto" class="form-label">Imagen</label><br />
                        <img id="vistaPreviaImagen" src="" alt="Vista previa" style="max-height: 150px; display:block; margin-bottom: 1rem;" />
                        <input class="form-control" type="file" id="imagenProducto" name="Imagen" accept="image/*" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script src="~/js/PerfilVendedor.js"></script>

