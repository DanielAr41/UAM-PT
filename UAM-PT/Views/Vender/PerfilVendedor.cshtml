@{
    ViewData["Title"] = "PerfilVendedor";
    //ViewData["TitleHeader"] = "Perfil de vendedor";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    /* ------------------------------
       ESTILOS GENERALES
    ---------------------------------*/
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
    }

    body {
        background-color: #fafafa; /* Blanco suave */
        color: #333;
    }

    /* ------------------------------
       BOTONES
    ---------------------------------*/
    .btnNaranja {
        background-color: #fff;
        border: 2px solid #FF8800;
        color: #FF8800;
        transition: 0.3s;
    }

        .btnNaranja:hover {
            background-color: #FF8800;
            color: #fff;
        }

    #AddProducto[disabled] {
        background-color: #bfbfbf;
        border-color: #bfbfbf;
        color: #fff;
    }

    .btn-new,
    .btn-vermas {
        background-color: #FF8800;
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 0.6rem 1.4rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-new:hover,
        .btn-vermas:hover {
            background-color: #e37300;
        }

    /* ------------------------------
       HEADER VENDEDOR
    ---------------------------------*/
    .header {
        background-color: #ffffff;
        padding: 1rem 2rem;
        border-bottom: 1px solid #eee;
    }

    /* ------------------------------
       BANNER
    ---------------------------------*/
    .banner img {
        width: 100%;
        height: 260px;
        object-fit: cover;
        border-radius: 10px;
    }

    /* ------------------------------
       PERFIL
    ---------------------------------*/
    .profile {
        text-align: center;
        padding: 2rem 1rem;
    }

    .profile-img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 4px solid #FF8800;
        object-fit: cover;
        margin-bottom: 1rem;
    }

    .profile h2 {
        font-size: 26px;
        margin-bottom: 5px;
    }

    .profile p {
        color: #777;
    }

    .stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin: 1.5rem 0;
    }

        .stats span {
            font-size: 14px;
            color: #444;
        }

    /* ------------------------------
       TABS
    ---------------------------------*/
    .tabs {
        display: flex;
        justify-content: center;
        gap: 2rem;
        padding: 1rem;
        font-weight: 600;
        border-bottom: 1px solid #ddd;
        background: #fff;
    }

        .tabs a {
            color: #555;
            text-decoration: none;
            padding-bottom: 4px;
        }

        .tabs .active {
            border-bottom: 2px solid #FF8800;
            color: #FF8800;
        }

    /* ------------------------------
       PRODUCTOS
    ---------------------------------*/
    .products {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
        padding: 2rem;
    }

    .product-card {
        background: #fff;
        border-radius: 14px;
        padding: 1rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.06);
        transition: 0.2s;
        position: relative;
    }

        .product-card:hover {
            transform: translateY(-3px);
        }

    /* Imagen */
    .product-image {
        position: relative;
        height: 160px;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Botón editar */
    .edit-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ffffffdd;
        border: none;
        border-radius: 50%;
        padding: 5px;
        cursor: pointer;
        transition: 0.3s;
    }

        .edit-btn:hover {
            background: #FF8800;
            color: white;
        }

    /* Información */
    .product-card h3 {
        font-size: 18px;
        margin-bottom: 3px;
        color: #333;
    }

    .product-card p {
        font-size: 14px;
        color: #666;
    }

    .info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.8rem;
    }

    .rating {
        background-color: #eee;
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 12px;
    }

    /* ------------------------------
       VER MÁS
    ---------------------------------*/
    .ver-mas-container {
        text-align: center;
        margin: 2rem 0;
    }

    .footer {
        padding: 1rem;
        text-align: center;
        font-size: 13px;
        color: #888;
    }

    /* ------------------------------
       MODALES
    ---------------------------------*/
    .tituloNaranja {
        color: #FF8800;
        font-size: 24px;
        font-weight: 600;
    }

    .inactive-btn {
        position: absolute;
        top: 10px;
        right: 45px;
        background: #ffffffdd;
        border: none;
        border-radius: 50%;
        padding: 5px;
        cursor: pointer;
        transition: 0.3s;
    }

        .inactive-btn:hover {
            background: #d9534f;
            color: white;
        }


    .activate-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ffffffdd;
        border: none;
        border-radius: 50%;
        padding: 5px;
        cursor: pointer;
        transition: 0.3s;
    }

        .activate-btn:hover {
        background: green;
        color: white;
    }


    /* ------------------------------
           MODAL AGREGAR PRODUCTO
        ---------------------------------*/
    #mdlAddProducto .btn-secondary {
        border-radius: 8px;
    }

    #mdlAddProducto .modal-content {
        border-radius: 14px;
        border: none;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        animation: modalFadeIn 0.3s ease;
    }

    /* Animación suave */
    @@keyframes modalFadeIn {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1); }
    }

    /* ---- Header ---- */
    #mdlAddProducto .modal-header {
    background: #fff;
    border-bottom: 2px solid #f5f5f5;
    padding: 1rem 1.5rem;
    }

    #mdlAddProducto .modal-title {
    font-size: 1.4rem;
    font-weight: 700;
    }

    /* ---- Botón cerrar ---- */
    #mdlAddProducto .modal-header .btn i {
    font-size: 1.6rem;
    transition: 0.2s ease;
    }

    #mdlAddProducto .modal-header .btn:hover i {
    transform: scale(1.15);
    color: #cc6e00 !important;
    }

    /* ---- Inputs ---- */
    #mdlAddProducto .form-control,
    #mdlAddProducto .form-select {
    border-radius: 10px;
    border-color: #ddd;
    padding: 0.55rem 0.9rem;
    transition: 0.2s;
    }

    #mdlAddProducto .form-control:focus,
    #mdlAddProducto .form-select:focus {
    border-color: #ff8800;
    box-shadow: 0 0 0 0.15rem rgba(255,136,0,0.25);
    }

    /* ---- Footer ---- */
    #mdlAddProducto .modal-footer {
    border-top: 2px solid #f5f5f5;
    padding: 1rem 1.5rem;
    }

    #mdlAddProducto .btnNaranja {
        background-color: #ff8800 !important;
        color: #fff;
        border: none !important;
        border-radius: 8px !important;
        padding: 0.5rem 1.2rem !important;
        font-weight: 600;
        transition: 0.2s ease !important;
    }

        #mdlAddProducto .btnNaranja:hover {
            background-color: #e67600 !important;
            transform: translateY(-1px);
        }

    .file-upload-box {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fafafa;
        padding: 1rem;
        border-radius: 12px;
        border: 2px dashed #ff8800;
        cursor: pointer;
        transition: 0.2s ease;
        position: relative;
    }

        .file-upload-box:hover {
            background: #fff3e6;
        }

    /* Icono */
    .upload-icon {
        font-size: 2rem;
        color: #ff8800;
    }

    /* Nombre archivo */
    #file-name {
        flex-grow: 1;
        font-size: 0.95rem;
        color: #7a7a7a;
    }

    /* Botón Upload */
    .btn-upload-trigger {
        background: #ff8800;
        border: none;
        padding: 6px 15px;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .btn-upload-trigger:hover {
            background: #d97300;
        }

    /* Input original oculto */
    #productoImagen {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    /* ----- INPUTS CON ÍCONOS ----- */
    .input-icon {
        position: relative;
        margin-bottom: 1rem;
    }

        .input-icon i {
            position: absolute;
            top: 50%;
            left: 12px;
            transform: translateY(-50%);
            font-size: 1.2rem;
            color: #ff8800;
        }

        .input-icon .form-control,
        .input-icon .form-select {
            padding-left: 42px !important;
            border-radius: 10px;
        }

    /* Para textarea */
    .textarea-icon i {
        top: 18px;
    }

    /* Focus */
    .input-icon .form-control:focus,
    .input-icon .form-select:focus,
    .textarea-icon textarea:focus {
        border-color: #ff8800;
        box-shadow: 0 0 0 0.15rem rgba(255,136,0,0.25);
    }

    #previewProductoImg {
        border-radius: 12px;
        object-fit: cover;
        background: #fafafa;
        padding: 6px;
    }

</style>

