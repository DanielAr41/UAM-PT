@{
    ViewData["Title"] = "PerfilVendedor";
    //ViewData["TitleHeader"] = "Perfil de vendedor";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    .btnNaranja {
        background-color: #fff;
        border-color: #FF8800;
        color: #FF8800;
    }

        .btnNaranja:hover {
            background-color: #FF8800;
            border-color: #FF8800;
            color: #fff;
        }

    #AddProducto[disabled] {
            background-color: #6c757d;
            border-color: #6c757d;
        }

        .tituloNaranja{
        color: #FF8800;
        font-size:25px;
        
        }



    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
    }

    body {
        background-color: #fff7f3;
        color: #333;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        background-color: #fff1e8;
    }

    .logo {
        height: 40px;
    }

    .user-menu {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .user-menu a {
            text-decoration: none;
            color: #000;
        }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
    }

    .banner img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .profile {
        text-align: center;
        padding: 1.5rem;
    }

    .profile-img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        margin-bottom: 1rem;
    }

    .stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin: 1rem 0;
        font-size: 14px;
    }

    .btn-new {
        background-color: #ff9a00;
        color: white;
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 20px;
        cursor: pointer;
    }

    .tabs {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        padding: 1rem;
        border-top: 1px solid #ccc;
        border-bottom: 1px solid #ccc;
        font-weight: 600;
    }

        .tabs a {
            text-decoration: none;
            color: #333;
        }

        .tabs .active {
            border-bottom: 2px solid #ff9a00;
            color: #ff9a00;
        }

    .products {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.5rem;
        padding: 2rem;
    }

    .product-card {
        background-color: white;
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 4px 8px rgba(0,0,0,0.05);
        position: relative;
    }

    .product-image {
        position: relative;
        height: 150px;
        overflow: hidden;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .edit-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        background: #fff;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        font-size: 16px;
    }

    .info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.5rem;
        font-size: 14px;
    }

    .rating {
        background-color: #eee;
        padding: 2px 6px;
        border-radius: 12px;
    }

    .btn-vermas {
        background-color: #ff9a00;
        color: white;
        padding: 0.6rem 1.5rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .ver-mas-container {
        text-align: center;
        margin: 2rem 0;
    }

    .footer {
        text-align: center;
        padding: 1rem;
        font-size: 13px;
        color: #999;
    }

</style>

