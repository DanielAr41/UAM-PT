@{
    ViewData["TitleHeader"] = "Detalles del pedido";
    Layout = "/Views/Shared/_Layout.cshtml";
}

@model PedidoModel
<div class="container">
    <!-- Encabezado -->
    <div class="header">
        <a href="@Url.Action("MisPedidos", "Pedidos")" class="back">← Regresar</a>
        <h2>Pedido <span class="order-id">#@Model.PedidoId</span></h2>
    </div>

    <div class="content">
        <!-- Estatus del pedido -->
        <div class="status">
            <h3>Estatus del pedido</h3>

            <div class="step @(Model.PasoActual >= 1 ? "active" : "")">
                <div class="step-number">1</div>
                <div class="step-info">
                    <strong>¡Ya casi en tu puerta!</strong>
                    <p>Preparando tu pedido</p>
                </div>
            </div>

            <div class="step @(Model.PasoActual >= 2 ? "active" : "")">
                <div class="step-number">2</div>
                <div class="step-info">
                    <strong>Pedido procesado</strong>
                    <p>En proceso de entrega</p>
                </div>
            </div>

            <div class="step @(Model.PasoActual >= 3 ? "active" : "")">
                <div class="step-number">3</div>
                <div class="step-info">
                    <strong>Entregado</strong>
                    <p>Pedido entregado con éxito</p>
                </div>
            </div>
        </div>

        <!-- Detalles de entrega -->
        <div class="details">
            <div class="delivery-date">
                <p>Fecha del pedido:</p>
                <strong>@Model.FechaPedido.ToString("dddd dd 'de' MMMM yyyy")</strong>
            </div>

            @foreach (var item in Model.Productos)
            {
                <div class="product">
                    <img src="@Url.Action("ObtenerImagen", "Home", new { id = item.ProductoId })" alt="@item.Nombre">
                    <div>
                        <p><a href="#">@item.Nombre</a></p>
                        <span>Cantidad: @item.Cantidad</span>
                    </div>
                    <span class="price">@item.Precio.ToString("C")</span>
                </div>
            }

            <div class="total">
                <span>Total</span>
                <strong>@Model.Productos.Sum(x => x.Cantidad * x.Precio).ToString("C")</strong>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        font-family: Arial, sans-serif;
        background: #fff;
        margin: 0;
        padding: 0;
        color: #333;
    }

    .container {
        width: 90%;
        max-width: 1000px;
        margin: 20px auto;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .back {
        text-decoration: none;
        color: #333;
        font-size: 14px;
    }

    .order-id {
        font-weight: bold;
    }

    .content {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }

    .status {
        width: 55%;
    }

        .status h3 {
            margin-bottom: 20px;
        }

    .step {
        display: flex;
        align-items: flex-start;
        border-bottom: 1px solid #ccc;
        padding: 10px 0;
    }

    .step-number {
        background: #2c3e50;
        color: #fff;
        font-weight: bold;
        width: 25px;
        height: 25px;
        border-radius: 3px;
        text-align: center;
        line-height: 25px;
        margin-right: 15px;
    }

    .step-info strong {
        display: block;
        margin-bottom: 5px;
    }

    .details {
        width: 40%;
    }

    .delivery-date {
        background: #ff9800;
        color: #fff;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        text-align: center;
    }

    .product {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        border-bottom: 1px solid #ddd;
        padding-bottom: 10px;
    }

        .product img {
            width: 50px;
            height: 50px;
            margin-right: 15px;
            border-radius: 5px;
        }

        .product p {
            margin: 0;
            font-weight: bold;
        }

        .product span {
            font-size: 13px;
            color: #666;
        }

        .product .price {
            margin-left: auto;
            font-weight: bold;
        }

    .total {
        display: flex;
        justify-content: space-between;
        font-size: 16px;
        margin-top: 15px;
        font-weight: bold;
    }


    .step {
        display: flex;
        align-items: flex-start;
        border-bottom: 1px solid #ccc;
        padding: 10px 0;
        opacity: 0.5;
    }

    .step-number {
        background: #ccc;
        color: #fff;
        font-weight: bold;
        width: 25px;
        height: 25px;
        border-radius: 3px;
        text-align: center;
        line-height: 25px;
        margin-right: 15px;
    }

    .step.active {
        opacity: 1;
    }

        .step.active .step-number {
            background: #2c3e50; /* Azul oscuro */
        }


</style>