
@{
    ViewData["TitleHeader"] = "Mis pedidos";
    Layout = "/Views/Shared/_Layout.cshtml";
}

@model List<UAM_PT.Models.PedidoModel>

<style>
    h1 {
        color: #ff9800;
    }

    .back {
        display: inline-flex;
        align-items: center;
        margin-bottom: 10px;
        text-decoration: none;
        color: #333;
        font-weight: 500;
    }

        .back::before {
            content: "←";
            margin-right: 5px;
        }

    .order-section {
        margin-bottom: 20px;
    }

    .order-date {
        font-weight: bold;
        margin-bottom: 10px;
    }

    .order-card {
        display: flex;
        align-items: center;
        background-color: #fff;
        border-radius: 10px;
        padding: 10px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        margin-bottom: 10px;
        border-left: 5px solid #1a1a3f;
    }

    .order-image {
        width: 80px;
        height: 80px;
        margin-right: 15px;
        border-radius: 5px;
        object-fit: cover;
    }

    .order-info {
        display: flex;
        flex-direction: column;
    }

    .order-status {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .in-process {
        color: #f9b200;
    }
    /* Amarillo */
    .delivered {
        color: #4caf50;
    }
    /* Verde */
</style>
    <a href="/Home/Inicio" class="back">Regresar</a>

   @*  <h1>Mis pedidos</h1> *@

@foreach (var pedido in Model)
{
    <div class="order-section">
        <div class="order-date">@pedido.FechaPedido.ToString("dd 'de' MMMM 'de' yyyy")</div>

        @foreach (var item in pedido.Productos)
        {
            <a href="@Url.Action("DetallesPedido", "Pedidos", new { pedidoId = pedido.PedidoId })" class="order-card">
                <img src="@Url.Action("ObtenerImagen", "Home", new { id = item.ProductoId })" alt="@item.Nombre" class="order-image">
                <div class="order-info">
                    <span class="order-status @(pedido.Estatus == "Entregado" ? "delivered" : "in-process")">
                        @pedido.Estatus
                    </span>
                    <span>@item.Cantidad @((item.Cantidad > 1) ? "productos" : "Producto")</span>
                </div>
            </a>

        }
    </div>
}

<script src="~/js/MisPedidos.js"></script>
