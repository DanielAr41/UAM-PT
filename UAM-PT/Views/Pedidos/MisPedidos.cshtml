
@{
    ViewData["TitleHeader"] = "Configuración de la cuenta";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<style>


    h1 {
        color: #ff9800;
    }

    .back {
        display: inline-flex;
        align-items: center;
        margin-bottom: 10px;
        text-decoration: none;
        color: #333;
        font-weight: 500;
    }

        .back::before {
            content: "←";
            margin-right: 5px;
        }

    .order-section {
        margin-bottom: 20px;
    }

    .order-date {
        font-weight: bold;
        margin-bottom: 10px;
    }

    .order-card {
        display: flex;
        align-items: center;
        background-color: #fff;
        border-radius: 10px;
        padding: 10px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        margin-bottom: 10px;
        border-left: 5px solid #1a1a3f;
    }

    .order-image {
        width: 80px;
        height: 80px;
        margin-right: 15px;
        border-radius: 5px;
        object-fit: cover;
    }

    .order-info {
        display: flex;
        flex-direction: column;
    }

    .order-status {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .in-process {
        color: #f9b200;
    }
    /* Amarillo */
    .delivered {
        color: #4caf50;
    }
    /* Verde */
</style>
    <a href="#" class="back">Regresar</a>

    <h1>Mis pedidos</h1>

    <div class="order-section">
        <div class="order-date">28 de Abril de 2025</div>

        <div class="order-card">
        <img src="\images\default.jpg" alt="Producto" class="order-image">
            <div class="order-info">
                <span class="order-status in-process">En proceso de entrega</span>
                <span>1 Producto</span>
            </div>
        </div>

        <div class="order-card">
        <img src="\images\default.jpg" alt="Producto" class="order-image">
            <div class="order-info">
                <span class="order-status delivered">Entregado</span>
                <span>2 productos</span>
            </div>
        </div>
    </div>

    <div class="order-section">
        <div class="order-date">14 de Marzo de 2025</div>

        <div class="order-card">
        <img src="\images\default.jpg" alt="Producto" class="order-image">
            <div class="order-info">
                <span class="order-status delivered">Entregado</span>
                <span>1 Producto</span>
            </div>
        </div>
    </div>

<script src="~/js/MisPedidos.js"></script>
