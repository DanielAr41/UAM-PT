@{
    ViewData["Title"] = "Registrarse";
    Layout = "/Views/Shared/_Layout.cshtml";
}


<style>
    body {
        background-color: #f8f9fa;
    }

    .login-container {
        max-width: 400px;
        margin: 100px auto;
        padding: 20px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="container">
    <div class="login-container">
        <h3 class="text-center">Registrarse</h3>
        <form id="RegistroForm">
            <div class="mb-3">
                <label for="NombreUsuario" class="form-label">Nombre(s)</label>
                <input type="text" class="border-2 form-control" id="NombreUsuario" placeholder="Ingrese su nombre" required>
            </div>
            <div class="mb-3">
                <label for="ApaternoUsuario" class="form-label">Primer Apellido</label>
                <input type="text" class="form-control" id="ApaternoUsuario" placeholder="Ingrese su primer apellido" required>
            </div>
            <div class="mb-3">
                <label for="AmaternoUsuario" class="form-label">Segundo Apellido</label>
                <input type="text" class="form-control" id="AmaternoUsuario" placeholder="Ingrese su segundo apellido">
            </div>
            <div class="mb-3">
                <label for="correoUsuario" class="form-label">Correo</label>
                <input type="text" class="form-control" id="correoUsuario" placeholder="example@gmail.com" required>
            </div>
            <div class="mb-3">
                <label for="pass" class="form-label">Contraseña</label>
                <input type="password" class="form-control" id="pass" placeholder="****" required>
            </div>
            <div class="mb-3">
                <label for="telefono" class="form-label">Teléfono</label>
                <input type="text" class="form-control" id="telefono" placeholder="5555555555" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-2" id="registro">Aceptar</button>
            <button type="button" class="btn btn-secondary w-100 mb-2" id="Regresar">Regresar</button>
            <div class="mt-3 text-center">
                <a href="/Account/RecuperarContrasenia">¿Olvidaste tu contraseña?</a>
            </div>
        </form>
    </div>
</div>

<script src="~/js/InicioSesion.js"></script>