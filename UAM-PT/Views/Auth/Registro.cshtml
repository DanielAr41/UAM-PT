@{
    ViewData["Title"] = "Registrarse";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f3f4f6;
        font-family: 'Poppins', sans-serif;
    }

    .login-container {
        max-width: 420px;
        margin: 80px auto;
        padding: 30px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0px 6px 14px rgba(0, 0, 0, 0.12);
        animation: fadeIn .4s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .login-container h3 {
        font-weight: 600;
        color: #333;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 500;
        color: #444;
    }

    input.form-control {
        padding: 10px 12px;
        border-radius: 8px;
        border: 2px solid #ced4da;
        transition: all 0.2s ease;
    }

    input.form-control:focus {
        border-color: #FF8800;
        box-shadow: 0 0 6px rgba(255, 136, 0, 0.4);
    }

    .password-wrapper {
        position: relative;
    }

    .toggle-pass {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 20px;
        color: #777;
    }

    .toggle-pass:hover {
        color: #333;
    }

    .text-error {
        font-size: 0.85rem;
        color: #d9534f;
        margin-top: 4px;
        display: none;
    }

    /* Botones */
    #registro {
        background-color: #FF8800 !important;
        border: none;
        font-weight: 600;
        border-radius: 8px;
        padding: 10px;
        transition: 0.2s ease;
    }

    #registro:disabled {
        opacity: 0.7;
    }

    .spinner {
        width: 18px;
        height: 18px;
        border: 3px solid transparent;
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
    }

    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>

<div class="container">
    <div class="login-container">
        <h3 class="text-center">Registrarse</h3>

        <form id="RegistroForm">

            <div class="mb-3">
                <label for="NombreUsuario" class="form-label">Nombre(s)</label>
                <input type="text" class="border-2 form-control" id="NombreUsuario" placeholder="Ingrese su nombre" required>
                <div class="text-error" id="errNombre">Ingrese un nombre válido</div>
            </div>

            <div class="mb-3">
                <label for="ApaternoUsuario" class="form-label">Primer Apellido</label>
                <input type="text" class="form-control" id="ApaternoUsuario" placeholder="Ingrese su primer apellido" required>
                <div class="text-error" id="errApaterno">Este campo es obligatorio</div>
            </div>

            <div class="mb-3">
                <label for="AmaternoUsuario" class="form-label">Segundo Apellido</label>
                <input type="text" class="form-control" id="AmaternoUsuario" placeholder="Ingrese su segundo apellido">
            </div>

            <div class="mb-3">
                <label for="correoUsuario" class="form-label">Correo</label>
                <input type="text" class="form-control" id="correoUsuario" placeholder="example@gmail.com" required>
                <div class="text-error" id="errCorreo">Ingrese un correo válido</div>
            </div>

            <div class="mb-3">
                <label for="pass" class="form-label">Contraseña</label>

                <div class="password-wrapper">
                    <input type="password" class="form-control" id="pass" placeholder="****" required>
                    <span class="toggle-pass" id="togglePass">&#128065;</span>
                </div>

                <div class="text-error" id="errPass">La contraseña debe tener al menos 6 caracteres</div>
            </div>

            <div class="mb-3">
                <label for="telefono" class="form-label">Teléfono</label>
                <input type="text" class="form-control" id="telefono" placeholder="5555555555" required>
                <div class="text-error" id="errTel">El teléfono debe tener 10 dígitos</div>
            </div>

            <button type="submit" class="btn w-100 mb-2" id="registro">Aceptar</button>
            <button type="button" class="btn btn-secondary w-100 mb-2" id="Regresar">Regresar</button>

            <div class="mt-3 text-center">
                <a href="/Account/RecuperarContrasenia">¿Olvidaste tu contraseña?</a>
            </div>

        </form>
    </div>
</div>

<script src="~/js/InicioSesion.js"></script>
