@{
    ViewData["Title"] = "Inicio de Sesión";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    body {
        background-color: #ffffff;
    }

    .login-container {
        max-width: 600px;
        margin: 100px auto;
        padding: 20px;
        background: #f8f5f5;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .container-logo {
        margin-bottom: -10px;
    }

    .nav_image {
        width: 100px;
        height: auto;
    }

    .login-container {
        margin-top: 0;
    }

    #loginGoogle {
        background-color: #fff;
        color: #dc3545;
        border-color: #dc3545;
        transition: all 0.3s;
    }

        #loginGoogle:hover {
            background-color: #dc3545;
            color: #fff;
        }

    .btnLoginStyle{
        background-color: #fff;
        border-color: #FF8800;
        color: #FF8800;
    }

    .btnLoginStyle:hover {
            background-color: #FF8800;
        border-color: #FF8800;
        color: #fff;
    }

    #Ingresar {
        transition: all 0.3s ease-in-out;
    }

        #Ingresar[disabled] {
            background-color: #6c757d;
            border-color: #6c757d;
        }

</style>

@* <div class="container-logo text-center">
    <img src="~/images/logo.png" alt="Logo" class="nav_image">
</div> *@
<div class="container mt-0">
    <div class="login-container">
        <h3 class="text-center">Iniciar Sesión</h3>
        <form id="loginForm">
            <div class="form-group mb-3">
                <label for="usuario">Correo</label>
                <input type="email" class="form-control" id="usuario" placeholder="correo@ejemplo.com">
            </div>

            <div class="form-group mb-3 position-relative">
                <label for="password">Contraseña</label>
                <input type="password" class="form-control" id="password" placeholder="contraseña">

                <!-- Icono de ojo -->
                <span class="toggle-password" style="position: absolute; top: 38px; right: 10px; cursor: pointer;">
                    <i class="fas fa-eye" id="toggleIcon"></i>
                </span>
            </div>



            <button type="submit" class="btn btnLoginStyle w-100 mb-2 me-2" id="Ingresar">
                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                Ingresar
            </button>

            <button type="button" class="btn btnLoginStyle w-100 mb-2 me-2" id="Registrar">Registrarse</button>

            <button type="button" class="btn btn-outline-danger w-100 mb-2" id="loginGoogle">
                <i class="fab fa-google me-2"></i> Iniciar sesión con Google
            </button>

            <div class="mt-3 text-center">
                <a href="/Account/RecuperarContrasenia">¿Olvidaste tu contraseña?</a>
            </div>
        </form>
    </div>
</div>


<script src="~/js/InicioSesion.js"></script>
  
