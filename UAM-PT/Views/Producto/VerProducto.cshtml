@{
    ViewData["Title"] = "Ver Producto";
    Layout = "/Views/Shared/_LayoutMain.cshtml"; /* aquí ya usas el layout principal marketplace */
}

@model UAM_PT.Models.ProductoModel

<style>
    .product-container{
        display:flex;
        gap:50px;
        margin-bottom:70px;
        margin-top:25px;
        flex-wrap:wrap;
        font-family:'Poppins', sans-serif;
    }

    .product-image img{
        width:100%;
        max-width:500px;
        border-radius:16px;
        object-fit:cover;
    }

    .product-details{
        max-width:520px;
    }

    .product-details h2{
        font-weight:600;
        font-size:28px;
        margin-bottom:15px;
        color:#222;
    }

    .product-details p{
        font-size:15px;
        color:#444;
        margin-bottom:12px;
    }

    .product-price{
        font-size:32px;
        font-weight:700;
        color:#FF8800;
        margin:20px 0;
    }

    .btn-novamer-primary{
        background:#FF8800;
        color:#fff;
        border:none;
        border-radius:10px;
        padding:12px 26px;
        font-weight:600;
        cursor:pointer;
        font-size:15px;
        transition:.2s;
    }

    .btn-novamer-primary:hover{
        transform:translateY(-1px);
        opacity:.92;
    }

    .reviews{
        margin-top:25px;
        font-size:14px;
        color:#333;
    }

    .review-stars{
        color:#FFD85C;
        font-size:18px;
    }

    /* relacionados */
    .related-products{
        margin-top:90px;
        font-family:'Poppins', sans-serif;
    }

    .related-card{
        border-radius:14px;
        border:1px solid #e8e8e8;
        padding:14px;
        transition:.2s;
        cursor:pointer;
        background:#fff;
    }

    .related-card:hover{
        transform:scale(1.03);
        box-shadow:0 3px 12px rgba(0,0,0,0.07);
    }

    .related-card img{
        width:100%;
        height:200px;
        object-fit:contain;
        background:#fafafa;
        border-radius:10px;
    }

    .related-card h5{
        margin-top:12px;
        font-size:15px;
        font-weight:500;
        color:#222;
    }

    .related-card p{
        font-size:17px;
        font-weight:600;
        color:#FF8800;
        margin-bottom:0;
    }

    /* responsive */
    @@media(max-width:768px){
        .product-container{
            flex-direction:column;
        }
    }
</style>


<div class="product-container container">
    <div class="product-image">
        <img src="/Home/ObtenerImagen?id=@Model.ID" alt="@Model.Nombre">
    </div>

    <div class="product-details">
        <h2>@Model.Nombre</h2>
        <p>@Model.Descripcion</p>

        <div class="product-price">
            $@Model.Precio
        </div>

        <button class="btn-novamer-primary btn-add" data-pid="@Model.ID">Agregar al carrito</button>

        <div class="reviews">
            <p>Reseñas de usuarios</p>
            <p class="review-stars">★★★★☆ <span style="font-size:14px;">(4.0 / 5)</span></p>
            <p><em>"Me encantó, es muy cómodo y fue fácil de armar"</em> - Emily R.</p>
        </div>
    </div>
</div>



<div class="related-products container">
    <h3>Productos Relacionados</h3>

    <div class="row g-4">
        @foreach (var item in Model.Relacionados)
        {
            <div class="col-md-3 col-6">
                <a href="@Url.Action("VerProducto", "Producto", new { id = item.ID })" style="text-decoration:none; color:inherit;">
                    <div class="related-card">
                        <img src="/Home/ObtenerImagen?id=@item.ID" alt="@item.Nombre">
                        <h5>@item.Nombre</h5>
                        <p>$@item.Precio</p>
                    </div>
                </a>
            </div>
        }
    </div>
</div>



<script src="~/js/DetallesProducto.js"></script>
